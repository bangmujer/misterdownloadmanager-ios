        }
      }
    },
    "Torrent downloads in this port are experimental: open Add Torrent and pick a .torrent file for peer download. Magnet placeholders do not download by themselves.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Unduhan torrent di port ini masih eksperimental: buka Tambah Torrent dan pilih berkas .torrent untuk mengunduh dari peer. Placeholder magnet tidak mengunduh sendiri."
          }
        }
