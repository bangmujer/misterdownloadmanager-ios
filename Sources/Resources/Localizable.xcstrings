      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Site (e.g. google.com)"
          }
        }
      }
    },
    "Nama pengguna": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Username"
          }
        }
