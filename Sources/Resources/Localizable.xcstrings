    "Unrestricts a file-host link with your own key from Settings → Debrid.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka tautan file-host dengan kunci Anda sendiri dari Pengaturan → Debrid."
