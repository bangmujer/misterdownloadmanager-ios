    "7z / RAR extraction needs the 7-Zip helper on desktop and is not available on iOS.": {
      "localizations": {
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekstraksi 7z / RAR butuh helper 7-Zip di desktop dan tidak tersedia di iOS."
